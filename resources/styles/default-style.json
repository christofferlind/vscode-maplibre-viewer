{
    "version": 8,
    "name": "VS Code MapLibre Viewer Default",
    "sources": {
        "default-background": {
            "type": "geojson",
            "data": {
                "type": "FeatureCollection",
                "features": []
            }
        }
    },
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": {
                "background-color": "#1e1e2e"
